{
    "name": "atoolo/genai-bundle",
    "description": "Indexing resources into a GenAI application and asking it questions",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "veltrup",
            "email": "veltrup@sitepark.com"
        }
    ],
    "require": {
        "php": ">=8.1 <8.6.0",
        "atoolo/index-bundle": "^1",
        "atoolo/resource-bundle": "^1.9",
        "overblog/graphql-bundle": "^1.10",
        "psr/log": "^3.0.2",
        "symfony/config": "^6.3 || ^7.4.17",
        "symfony/console": "^6.3 || ^7.4.20",
        "symfony/dependency-injection": "^6.3 || ^7.4.20",
        "symfony/http-client": "^6.3 || ^7.4.20",
        "symfony/http-client-contracts": "^2.5 || ^3.7.3",
        "symfony/http-foundation": "^6.3 || ^7.4.20",
        "symfony/http-kernel": "^6.3 || ^7.4.20",
        "symfony/yaml": "^6.3 || ^7.4.20"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "infection/infection": "^0.27.11",
        "overtrue/phplint": "^9.7.2",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "phpunit/phpunit": "^10.5.65",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.13.6",
        "symfony/filesystem": "^6.3 || ^7.4.18"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Atoolo\\GenAi\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoolo\\GenAi\\Test\\": "test"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "post-install-cmd": "phive --no-progress install --trust-gpg-keys C00543248C87FB13,4AA394086372C20A,CF1A108D0E7AE720,51C67305FFC2E5C0,E82B2FB314E9906E",
        "analyse": [
            "@analyse:phplint",
            "@analyse:phpstan",
            "@analyse:phpcsfixer",
            "@analyse:compatibilitycheck"
        ],
        "analyse:compatibilitycheck": "./vendor/bin/phpcs --standard=./phpcs.compatibilitycheck.xml",
        "analyse:phpcsfixer": "./tools/php-cs-fixer check --diff --show-progress=dots",
        "analyse:phplint": "./vendor/bin/phplint",
        "analyse:phpstan": "./tools/phpstan analyse",
        "fix": [
            "@fix:phpcsfixer"
        ],
        "fix:phpcsfixer": "./tools/php-cs-fixer fix",
        "report": [
            "@report:phpstan"
        ],
        "report:phpstan": "./tools/phpstan analyse --no-progress --no-ansi --no-interaction --error-format=checkstyle > ./var/log/phpstan-report.xml || exit 0",
        "test": [
            "@test:phpunit"
        ],
        "test:infection": "vendor/bin/infection --threads=8 --no-progress --only-covered -s || exit 0",
        "test:phpunit": "./tools/phpunit.phar -c phpunit.xml --coverage-text"
    }
}
